{
  "what": "Exact coverage of Wilson, Clopper-Pearson and Jeffreys in the rare-event regime",
  "produced_by": "r/coverage_fixtures.R",
  "why": "C-30(c) asserted a region three times and was wrong three times. Coverage has a definition, so it is asserted instead. This fixture answers whether the blog's claim (Jeffreys over-covers for rare events) and S-1.1's claim (Jeffreys has excellent average coverage) are in conflict. They measure different quantities, so they may both be true.",
  "instrument_validated_against": "S-1.1 sections 3.2 and 4.1.1, published limits",
  "validation": [
    {
      "label": "S-1.1 4.1.1  Wilson p=0.1765/n conf=0.95",
      "got": 0.8381922508520416,
      "want": 0.838,
      "passed": true
    },
    {
      "label": "S-1.1 4.1.1  Wilson p=0.1174/n conf=0.99",
      "got": 0.889226366119887,
      "want": 0.889,
      "passed": true
    },
    {
      "label": "S-1.1 3.2    Wilson lim inf, gamma>=1, conf=0.95",
      "got": 0.919790657159799,
      "want": 0.92,
      "passed": true
    }
  ],
  "exact_call": "wilson: closed form, kappa = qnorm(1 - (1-conf)/2); clopper_pearson: binom.test(k, n, conf.level = conf)$conf.int; jeffreys: qbeta({alpha/2, 1-alpha/2}, k+0.5, n-k+0.5), with LJ(0)=0 and UJ(n)=1 per S-1.1 section 3.1.3; coverage: sum(dbinom(k, n, p)) over k whose interval contains p",
  "environment": {
    "image_digest": "sha256:c3f39b365d1077fe24f8e9ab2742e352b6d3950897f51af1624a5bb5550c21c0",
    "r_version": "R version 4.5.3 (2026-03-11)",
    "cran_snapshot": "https://p3m.dev/cran/__linux__/noble/2026-04-23"
  },
  "standards": {
    "anchor": "S-1.1 Brown, Cai & DasGupta (2001), DOI 10.1214/ss/1009213286"
  },
  "axes": {
    "varied": ["n", "conf", "p = gamma/n for gamma in [0.5, 15]"],
    "held_fixed": "none",
    "note": "An agreement or coverage figure states its axes."
  },
